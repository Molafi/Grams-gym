# ─────────────────────────────────────────────────────────────────────────────
# GRAMS GYM — environment variables. Copy to `.env` and fill in.
# Validated at boot by lib/env.ts (the app refuses to start with invalid values).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used for metadata, sitemap, redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Local: `npm run db:up` starts docker-compose Postgres.
DATABASE_URL=postgresql://grams:grams@localhost:5432/grams_gym?schema=public

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-with-a-long-random-string
# Canonical URL Auth.js uses for callbacks (same as site URL in most setups).
AUTH_URL=http://localhost:3000
# Required on non-Vercel hosts behind a proxy.
AUTH_TRUST_HOST=true


# ── Test accounts (BUILD PHASE ONLY) ─────────────────────────────────────────
# true = one-click "Continue as test member / test admin" + TEST MODE ribbon.
# GO-LIVE: set to false. That single switch removes test login everywhere.
ENABLE_TEST_ACCOUNT=true
# Test login is hard-blocked when NODE_ENV=production (includes `next start` and
# Vercel deployments) unless this is ALSO true. Use only for a private preview.
# Even then, only the test MEMBER login is offered; the test admin login never is.
ALLOW_TEST_ACCOUNT_IN_PROD=false
TEST_MEMBER_EMAIL=member@test.gramsgym.local
TEST_MEMBER_PASSWORD=change-me-member
TEST_ADMIN_EMAIL=admin@test.gramsgym.local
TEST_ADMIN_PASSWORD=change-me-admin

# ── Lemon Squeezy (memberships) ──────────────────────────────────────────────
# Leave API key empty while testing: the built-in payment SIMULATOR is used instead
# (only when test accounts are enabled). See docs/SETUP.md.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# true = create checkouts in test mode (use card 4242 4242 4242 4242).
# If unset: true in development, false in production. On a live site, test-mode
# webhooks are ignored and test-mode memberships stop granting access.
LEMONSQUEEZY_TEST_MODE=true

# One Lemon Squeezy VARIANT ID per (plan, interval).
LS_VARIANT_STARTER_MONTHLY=
LS_VARIANT_STARTER_QUARTERLY=
LS_VARIANT_STARTER_YEARLY=
LS_VARIANT_PRO_MONTHLY=
LS_VARIANT_PRO_QUARTERLY=
LS_VARIANT_PRO_YEARLY=
LS_VARIANT_ELITE_MONTHLY=
LS_VARIANT_ELITE_QUARTERLY=
LS_VARIANT_ELITE_YEARLY=
# Only used when SUPPLEMENT_PAYMENT_MODE=lemonsqueezy: a generic "Supplement order"
# variant charged with a custom price equal to the server-computed order total.
LS_VARIANT_SUPPLEMENT_ORDER=
# Your Lemon Squeezy store's currency, and how many of its units equal 1 JOD (e.g. 1.41
# for USD). Supplement orders through Lemon Squeezy are refused until the rate is set.
LS_STORE_CURRENCY=USD
LS_JOD_EXCHANGE_RATE=

# manual = pay at the gym / cash on delivery (default, recommended)
# lemonsqueezy = card checkout via Lemon Squeezy (approval risk — see docs/OWNER-TODO.md)
SUPPLEMENT_PAYMENT_MODE=manual

# Days a past_due membership keeps access while the card is retried.
MEMBERSHIP_GRACE_DAYS=3

# Delivery fee inside Amman, in minor units (JOD has 3 decimals → 2000 = 2.000 JOD). Placeholder.
DELIVERY_FEE_MINOR=2000

# Optional transactional email (Resend). Empty = emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="GRAMS GYM <no-reply@example.com>"

# Set to 1 to skip env validation (e.g. building a Docker image without secrets).
SKIP_ENV_VALIDATION=
